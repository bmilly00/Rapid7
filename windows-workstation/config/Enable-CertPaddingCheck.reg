Windows Registry Editor Version 5.00

; CVE-2013-3900 / MS13-098 - WinVerifyTrust signature padding check (opt-in)
; https://msrc.microsoft.com/update-guide/vulnerability/CVE-2013-3900
; Double-click to import, or:  reg import Enable-CertPaddingCheck.reg
; Same effect as scripts\01-Fix-CVE-2013-3900.ps1.
; On 64-bit Windows BOTH keys below are required.

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Cryptography\Wintrust\Config]
"EnableCertPaddingCheck"="1"

[HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\Microsoft\Cryptography\Wintrust\Config]
"EnableCertPaddingCheck"="1"
